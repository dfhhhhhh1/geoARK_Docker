# Frontend build-time config. Copy to .env only if you need to override.
#
# Vite exposes ONLY variables prefixed with VITE_ to the browser bundle, so
# never put a secret here, anything VITE_-prefixed ships to every visitor.
#
# API URLs are relative (/api, /automl) and proxied by nginx in Docker or by the
# Vite dev server locally, so there is normally nothing to set.

# VITE_APP_TITLE=GeoARK

# CARTO Basemaps key. Without it the raster tiles carry an "API key
# required" watermark. NOT a secret: Vite inlines this into the bundle and the
# browser sends it with every tile request, so it is visible to any visitor.
# Kept here only to keep it out of the repository.
VITE_CARTO_KEY=
