# Copy to .env and fill in. .env must never be committed.

# --- required ---
POSTGRES_PASSWORD=change_me_to_something_long

# --- optional, with sane defaults ---
POSTGRES_DB=mygisdb
POSTGRES_USER=geoark
WEB_PORT=8080
# CARTO basemap key, baked into the web image. Without it the Light, Voyager
# and Dark tiles carry an "API key required" watermark. Not a secret: it is
# sent with every tile request.
VITE_CARTO_KEY=

LLM_MODEL=gemma3:4b
EMBED_MODEL=BAAI/bge-base-en-v1.5

# Set to 1 after the first successful start so the embedder never blocks on a
# network call to huggingface.co again.
HF_HUB_OFFLINE=0

# Match to the server's core count.
OMP_NUM_THREADS=4

# --- memory ---
# The LLM dominates RAM: gemma3:4b resident is ~5.5 GB. With KEEP_ALIVE=-1 it
# never unloads, which is right when you have headroom and wrong when you do
# not -- on a host giving Docker under ~16 GB, a sustained run can OOM the
# model runner mid-request.
#
# Uncomment on a constrained host to reclaim idle memory (costs a ~10s reload
# on the next cold request):
# OLLAMA_KEEP_ALIVE=30m
#
# Raise only once the Phase 3 router/planner split needs two resident models:
# OLLAMA_MAX_LOADED_MODELS=2

# Where the source geodata lives (outside the repo, ~3.5 GB).
GEODATA_DIR=../../geospatial_database_data

# --- access control ---
#
# LEAVING ACCESS_CODE UNSET MEANS NO AUTHENTICATION. Every endpoint is open,
# including /api/analyze, which is ~19s of GPU time per request. That is the
# right default for localhost -- it keeps the eval harness and dev loop working
# with no ceremony -- and it is wrong for anything reachable from elsewhere.
# The server prints a warning at startup whenever it is unset.
#
# Set it, and the API requires a session cookie obtained from POST /api/login.
# Comma-separated for several codes, so one can be revoked without disturbing
# the others:
# ACCESS_CODE=first-code,second-code
#
# Signs session cookies. Unset means a random key generated at each start, so
# everyone is signed out whenever the container restarts. Set it in production;
# never share it between deployments.
# SESSION_SECRET=
# SESSION_TTL_HOURS=12

# --- rate limits (per signed-in session, or per IP when anonymous) ---
# Analysis costs three orders of magnitude more than retrieval, hence two tiers.
# RATE_ANALYZE_BURST=5
# RATE_ANALYZE_PER_MIN=6
# RATE_SEARCH_BURST=30
# RATE_SEARCH_PER_MIN=60

# --- work queue ---
# Analyses are queued rather than run concurrently: two resident models already
# occupy 15.8 of 16.4 GB of VRAM, so a second simultaneous generation has
# nowhere to live. Raise only on hardware that can actually hold it.
# ANALYZE_CONCURRENCY=1
# ANALYZE_QUEUE_DEPTH=20

# ---- literature expansion (docs/EXPANSION.md) ------------------------------
# Folder holding semmedVER43_2024_R_PREDICATION.csv.gz (and optionally the
# scispaCy UMLS KB .jsonl). Read only by `make semmed`.
# SEMMED_DIR=../searchImprovement/search/search
# On by default (a no-op without `make semmed`); requests can pass {"expand": false}.
# EXPAND_ENABLED=1
# EXPAND_MIN_SIM=0.61
