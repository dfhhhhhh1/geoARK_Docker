# Copy to .env and fill in. .env must never be committed.

# --- required ---
POSTGRES_PASSWORD=change_me_to_something_long

# --- optional, with sane defaults ---
POSTGRES_DB=mygisdb
POSTGRES_USER=geoark
WEB_PORT=8080

LLM_MODEL=gemma3:4b
EMBED_MODEL=BAAI/bge-base-en-v1.5

# Set to 1 after the first successful start so the embedder never blocks on a
# network call to huggingface.co again.
HF_HUB_OFFLINE=0

# Match to the server's core count.
OMP_NUM_THREADS=4
